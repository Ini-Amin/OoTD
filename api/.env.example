# Local Postgres started with: initdb -D api/tmp/pgdata ... (see README)
DATABASE_URL=postgres://ootd@/ootd?host=/tmp&port=5433
PORT=8080
ALLOWED_ORIGIN=http://localhost:5173

# --- Magic Tag + AI Stylist (Meta AI) ---
# Any OpenAI-compatible endpoint works (Meta Model API, Baseten, ...).
# Leave AI_API_KEY empty to disable the AI endpoints (they answer 503).
#
# Meta Model API ($150 hackathon credits): key looks like LLM_<id>_<secret>,
# get it at https://dev.meta.ai after claiming credits.
AI_BASE_URL=https://api.meta.ai/v1
AI_API_KEY=
AI_VISION_MODEL=muse-spark-1.3
AI_CHAT_MODEL=muse-spark-1.3
#
# Alternative: Baseten (no card; model id for the hackathon: meta-models/muse-spark-open-1026)
# AI_BASE_URL=https://api.baseten.co/v1
# AI_VISION_MODEL=meta-models/muse-spark-open-1026
# AI_CHAT_MODEL=meta-models/muse-spark-open-1026
# AI_TIMEOUT_SECS=60
